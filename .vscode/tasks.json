{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build: Kompilieren",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "compile",
                "--fqbn",
                "arduino:renesas_uno:unor4wifi",
                "${workspaceFolder}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build: Hochladen",
            "type": "shell",
            "command": "arduino-cli",
            "args": [
                "upload",
                "-p",
                "COM9", 
                "--fqbn",
                "arduino:renesas_uno:unor4wifi",
                "${workspaceFolder}"
            ],
            "problemMatcher": []
        }
    ]
}